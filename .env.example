# Copy to .env.local at repo root (and/or backend/.env + frontend/.env.local):
#   cp .env.example .env.local
#
# Never commit real secrets. Use placeholders only in this file.
# Production: set these in Railway (API) and Vercel (NEXT_PUBLIC_*). See DEPLOYMENT.md
#
# If any secret was ever hardcoded or committed, rotate it immediately
# (JWT_SECRET, SECRET_KEY_BASE, DB password, Judge0, LiveKit, etc.).

# -----------------------------------------------------------------------------
# Frontend (Vercel / Next.js)
# NEXT_PUBLIC_* is exposed to the browser — never put JWT_SECRET, DATABASE_URL,
# LIVEKIT_API_SECRET, or JUDGE0_API_KEY here.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4004
NEXT_PUBLIC_APP_URL=http://localhost:3400
NEXT_PUBLIC_CABLE_URL=ws://localhost:4004/cable
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# -----------------------------------------------------------------------------
# Backend (Railway / Rails) — server-side only
# -----------------------------------------------------------------------------
RAILS_ENV=development
PORT=4004
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/codemehfil_development
REDIS_URL=redis://localhost:6379/1

# Required in production (32+ random chars). Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SECRET_KEY_BASE=

CORS_ORIGINS=http://localhost:3400,http://localhost:3005

# Optional — LiveKit (API secret must stay server-side)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# Optional — Judge0
JUDGE0_API_KEY=
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
